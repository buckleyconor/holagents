    {
      "scope": "module-03-similarity-search",
      "rubric": "analytic/step-clarity",
      "kind": "analytic",
      "status": "passed",
      "score": 4.5,
      "rounds": 1,
      "findings": [
        {
          "criterion": "actionable-steps",
